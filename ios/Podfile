# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

def fix_framework_plist(plist_path, min_os)
  return unless File.file?(plist_path)

  set_ok = system('/usr/libexec/PlistBuddy', '-c', "Set :MinimumOSVersion #{min_os}", plist_path,
                  out: File::NULL, err: File::NULL)
  unless set_ok
    system('/usr/libexec/PlistBuddy', '-c', "Add :MinimumOSVersion string #{min_os}", plist_path,
           out: File::NULL, err: File::NULL)
  end

  version = `/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "#{plist_path}" 2>/dev/null`.strip
  if version.empty?
    system('/usr/libexec/PlistBuddy', '-c', 'Add :CFBundleShortVersionString string 1.0', plist_path,
           out: File::NULL, err: File::NULL)
  end
end

post_install do |installer|
  min_os = '15.0'
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_os

      # gRPC-Core / gRPC-C++: ensure Abseil and address_sorting headers are found.
      if target.name.include?('gRPC-Core') || target.name.include?('gRPC-C++')
        paths = config.build_settings['HEADER_SEARCH_PATHS']
        paths = paths.is_a?(Array) ? paths.dup : (paths.to_s.split)
        paths << '"${PODS_ROOT}/abseil"'
        # address_sorting/address_sorting.h lives in third_party/address_sorting/include
        grpc_root = target.name.include?('gRPC-C++') ? 'gRPC-C++' : 'gRPC-Core'
        paths << '"${PODS_ROOT}/' + grpc_root + '/third_party/address_sorting/include"'
        config.build_settings['HEADER_SEARCH_PATHS'] = paths
      end
    end

    # BoringSSL-GRPC: remove -GCC_WARN_INHIBIT_ALL_WARNINGS only (Xcode 16+ clang rejects it).
    # Do NOT remove -G; that can break LC_ENCRYPTION_INFO / "binary invalid" on App Store upload.
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |f| f == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
  end

  # ITMS-90208: gRPC / Firebase binary pods ship with low or missing MinimumOSVersion.
  Dir.glob(File.join(installer.sandbox.root, '**', '*.framework', 'Info.plist')).each do |plist|
    fix_framework_plist(plist, min_os)
  end
end
