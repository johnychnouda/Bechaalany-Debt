{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/privacy-policy",
        "destination": "/legal/privacy-policy.html",
        "type": 301
      },
      {
        "source": "/privacy-policy.html",
        "destination": "/",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "ios": {
        "default": {
          "projectId": "bechaalany-debt-app-e1bb0",
          "appId": "1:908856160324:ios:08460e3562c039349f8c11",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "android": {
        "default": {
          "projectId": "bechaalany-debt-app-e1bb0",
          "appId": "1:908856160324:android:1a848127d23fd5c59f8c11",
          "uploadDebugSymbols": false,
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "bechaalany-debt-app-e1bb0",
          "configurations": {
            "ios": "1:908856160324:ios:08460e3562c039349f8c11",
            "android": "1:908856160324:android:1a848127d23fd5c59f8c11",
            "web": "1:908856160324:web:f2cd4542f89684bf9f8c11"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
